#include "keymap_brazilian_abnt2.h"
#include "keycodes.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&sk { ignore-modifiers; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <6>;
    scroll-layers = <7>;
};

/ {
    behaviors {
        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to_layer_0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        unstick: unstick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
            label = "ZM_unstick";
        };

        caret: caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(NUMBER_6) &kp E>;
            label = "CARET";
        };

        quote: quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(SINGLE_QUOTE) &kp E>;
            label = "QUOTE";
        };

        tilde: tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk TILDE &kp A>;
            label = "TILDE";
        };

        accent: accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk GRAVE &kp A>;
            label = "ACCENT";
        };

        crtlAlt: crtlAlt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp LEFT_ALT>;
            label = "CRTLALT";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_accent {
            timeout-ms = <200>;
            key-positions = <41 39>;
            bindings = <&mo 0>;
        };

        combo_sym2 {
            timeout-ms = <200>;
            key-positions = <41 40>;
            bindings = <&mo 4>;
        };

        combo_settings {
            timeout-ms = <200>;
            key-positions = <38 39>;
            bindings = <&mo 5>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <14 13>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <4 3>;
        };

        Esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        Ctrl-stiky {
            bindings = <&sk LEFT_CONTROL>;
            key-positions = <22 23>;
        };

        Shift_sticky {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <10 11>;
        };

        Play-Pause {
            bindings = <&kp C_PLAY_PAUSE>;
            key-positions = <2 3>;
        };

        Enter {
            bindings = <&kp RETURN>;
            key-positions = <25 24 26>;
        };

        Linguagem {
            bindings = <&kp LG(SPACE)>;
            key-positions = <38 39 40 41>;
        };

        enter2 {
            bindings = <&kp RETURN>;
            key-positions = <29 30 31>;
        };

        backspace2 {
            bindings = <&kp BACKSPACE>;
            key-positions = <17 18>;
        };

        ControlAlt {
            bindings = <&crtlAlt>;
            key-positions = <22 10 0>;
        };

        PrintScreem {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <0 4>;
        };

        FormatarVS {
            bindings = <&kp LA(LS(F))>;
            key-positions = <22 26>;
        };

        Terminal {
            bindings = <&kp LC(GRAVE)>;
            key-positions = <14 22>;
        };

        CtrlB {
            bindings = <&kp LC(B)>;
            key-positions = <22 4>;
        };

        Comment {
            bindings = <&kp LC(SLASH)>;
            key-positions = <10 14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Base";
            bindings = <
&kp Q      &kp W         &kp E         &kp R                        &kp T                                       &kp Y  &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D         &kp F                        &kp G  &kp LS(LG(S))         &kp MINUS      &kp H  &kp J  &kp K      &kp L    &kp QMARK
&kp Z      &kp X         &kp C         &kp V                        &kp B  &kp COLON             &kp SEMICOLON  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SEMICOLON
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 INT_HENKAN  &mo 2  &qt LSHIFT SPACE      &kp SPACE      &sl 1                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        sym_layer {
            label = "Sym.";
            bindings = <
&kp N1            &kp N2       &kp N3                 &kp NUMBER_4     &kp N5                                 &kp NUMBER_6  &kp N7           &kp N8             &kp N9     &kp N0
&kp LESS_THAN     &kp AT_SIGN  &kp LEFT_PARENTHESIS   &kp LEFT_BRACE   &kp LEFT_BRACKET   &trans      &trans  &kp EQUAL     &sk TILDE        &kp SINGLE_QUOTE   &kp PLUS   &kp ASTERISK
&kp GREATER_THAN  &kp DOLLAR   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans      &trans  &kp PERCENT   &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp MINUS  &sk CARET
&trans            &trans       &trans                 &trans           &mo 3              &mo 4       &trans  &trans                                                       &trans
            >;
        };

        ext_layer {
            label = "Mods";
            bindings = <
&kp ESC    &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_PAUSE                            &kp PG_UP     &kp HOME  &kp UP    &kp END    &kp CAPS
&sk LALT   &sk LGUI    &sk LSHIFT  &sk LCTRL   &kp RALT     &trans         &trans     &kp PG_DN     &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL
&kp LC(Z)  &kp LC(X)   &kp LC(C)   &kp TAB     &kp LC(V)    &trans         &trans     &kp LC(BSPC)  &kp BSPC  &trans    &trans     &trans
&trans     &trans      &trans      &trans      &trans       &kp LCTRL      &kp ENTER  &mo 3                                        &trans
            >;
        };

        fnc_layer {
            label = "FRow";
            bindings = <
&kp F1    &kp F2    &kp F3      &kp F4     &kp F5                        &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&sk LALT  &sk LGUI  &sk LSHIFT  &sk LCTRL  &kp RALT  &trans      &trans  &kp F11  &kp F12  &none   &trans  &trans
&none     &none     &none       &none      &none     &trans      &trans  &none    &none    &none   &none   &none
&trans    &trans    &trans      &trans     &none     &none       &none   &none                             &trans
            >;
        };

        symbols_2_layer {
            label = "Sym.2";
            bindings = <
&none   &kp UNDERSCORE  &kp MINUS             &kp AMPERSAND  &kp POUND                      &none  &none  &none  &none  &none
&none   &sk GRAVE       &kp NON_US_BACKSLASH  &kp PIPE       &kp SLASH  &trans      &trans  &none  &none  &none  &none  &none
&none   &none           &none                 &none          &none      &trans      &trans  &none  &none  &none  &none  &none
&trans  &trans          &trans                &trans         &none      &none       &none   &none                       &trans
            >;
        };

        settings_layer {
            label = "Sett.";
            bindings = <
&bootloader  &none   &none   &bt BT_CLR  &bt BT_SEL 0                      &bt BT_SEL 3  &none  &unstick  &none  &bootloader
&none        &none   &none   &none       &bt BT_SEL 1  &trans      &trans  &bt BT_SEL 4  &none  &none     &none  &none
&none        &none   &none   &none       &bt BT_SEL 2  &trans      &trans  &bt BT_SEL 5  &none  &none     &none  &none
&trans       &trans  &trans  &trans      &none         &none       &none   &none                                 &trans
            >;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        scroll_layer {
            label = "Scrl";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
